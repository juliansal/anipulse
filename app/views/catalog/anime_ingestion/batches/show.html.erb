<p style="color: green"><%= notice %></p>

<section class="section">
  <%= render @catalog_anime_ingestion_batch %>
</section>

<%= turbo_stream_from @catalog_anime_ingestion_batch %>

<div>
  <%= button_to "Preview Batch", 
    uploads_catalog_anime_ingestion_batches_path, 
    params: { batch_id: @catalog_anime_ingestion_batch.id },
    class: "button is-info is-dark" %>
</div>

<div id="uploads"></div>
<br>

<section class="section">
  <div class="buttons">
    <%= link_to "Back to anime ingestion batches", 
      catalog_anime_ingestion_batches_path,
      class: "button is-link is-dark" %>

    <%= button_to "Destroy this anime ingestion batch", 
      @catalog_anime_ingestion_batch, 
      method: :delete, 
      class: "button is-danger is-dark" %>
  </div>
</section>