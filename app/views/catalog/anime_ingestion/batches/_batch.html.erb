<div class="block" id="<%= dom_id batch %>">
  <div>
    <strong>File name:</strong>
    <%= batch.file_name %>
  </div>

  <div>
    <strong>Source:</strong>
    <%= batch.source %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= batch.status %>
  </div>

  <div>
    <strong>Records processed:</strong>
    <%= batch.records_processed %>
  </div>

  <div>
    <strong>Records failed:</strong>
    <%= batch.records_failed %>
  </div>

  <div>
    <strong>Error log:</strong>
    <%= batch.error_log %>
  </div>

</div>
